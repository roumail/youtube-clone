# Copy to .env (gitignored) and set your own path. Quote paths with spaces.
# Used by tools/run_prepare.sh. Command-line options override these.

# Default --dest: where prepared videos go.
KIDS_LIBRARY="$HOME/Library/CloudStorage/GoogleDrive-<your-account>/My Drive/Kids Library"

# 1 = always run detached in tmux (like --tmux); --no-tmux overrides for one run.
RUN_PREPARE_TMUX=0

# Used by tools/share_library.sh (optional; these are the defaults).
# SHARE_DIR="$HOME/Kids Library Share"
# SHARE_NAME="Kids Library"
