<mxfile host="drawio"><diagram id="arch" name="Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Kids video library: architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;Static PWA, no server, no accounts. Videos are prepared once into .kidsvideo files, kept on the shelf (Google Drive), and streamed or stored per device.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="-60" width="1100" height="50" as="geometry"/></mxCell><mxCell id="c3" value="Words used throughout" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="430" height="410" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&amp;quot;text-align:left&amp;quot;&gt;&lt;b&gt;.kidsvideo&lt;/b&gt;: one prepared video (DASH parts in a tar), made once per video by the tools in tools/ (see tools/README.md; not part of this diagram).&lt;br&gt;&lt;br&gt;&lt;b&gt;The shelf&lt;/b&gt;: where the prepared videos live, normally a “Kids Library” folder in Google Drive. It holds everything.&lt;br&gt;&lt;br&gt;&lt;b&gt;The catalogue&lt;/b&gt;: what one device shows the child; each device has its own.&lt;br&gt;&lt;br&gt;&lt;b&gt;Streamed&lt;/b&gt;: added from Google Drive; the device keeps title + poster and plays from the shelf (needs the internet).&lt;br&gt;&lt;br&gt;&lt;b&gt;Stored&lt;/b&gt;: added with “Add video”; a copy lives on the device and plays offline. A &lt;b&gt;download&lt;/b&gt; is a stored copy of a streamed video.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="390" height="345" as="geometry"/></mxCell><mxCell id="c5" value="The shelf and other sources of .kidsvideo files" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f3faf0;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="20" width="400" height="410" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Google Drive: “Kids Library”&lt;/b&gt;&lt;br&gt;all prepared videos, in series folders&lt;br&gt;shared with the read-only &lt;i&gt;device account&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="70" width="360" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Files on the iPad / iPhone&lt;/b&gt;&lt;br&gt;AirDrop from the Mac, or downloaded from Drive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="290" width="360" height="80" as="geometry"/></mxCell><mxCell id="c8" value="Google services (loaded only if google.json exists)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fdf3f3;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="910" y="20" width="340" height="410" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Google Identity Services&lt;/b&gt;&lt;br&gt;sign-in token, drive.readonly scope&lt;br&gt;lasts about an hour, renewed on a tap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="70" width="300" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Google Picker&lt;/b&gt;&lt;br&gt;files, folders, “Shared with me”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="170" width="300" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Drive API&lt;/b&gt;&lt;br&gt;list a picked folder’s .kidsvideo files&lt;br&gt;read byte ranges of a file while playing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="260" width="300" height="80" as="geometry"/></mxCell><mxCell id="c12" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0;exitY=0.25;entryX=1;entryY=0.75;" edge="1" parent="1" source="c11" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="Code, CI and release (GitHub)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f7f2fa;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1280" y="20" width="400" height="410" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;GitHub repo&lt;/b&gt; · main protected, PRs only, squash merge&lt;br&gt;specs in e2e/features are the source of truth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="60" width="360" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;CI&lt;/b&gt; · e2e (Playwright: Chromium iPad, WebKit iPad / iPhone)&lt;br&gt;repo-hygiene · CodeQL · image scan · coverage gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="135" width="360" height="60" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;tools/release.sh&lt;/b&gt; (owner only)&lt;br&gt;tag vMAJOR.MINOR.PATCH + GitHub Release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="220" width="360" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;deploy.yml&lt;/b&gt; → GitHub Pages&lt;br&gt;static app/ + google.json (Google project values)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="295" width="360" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Live site&lt;/b&gt; (HTTPS) · runs exactly the latest release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="365" width="360" height="45" as="geometry"/></mxCell><mxCell id="c19" value="every PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="owner merges, then releases" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="publish triggers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="Each device: the installed web app (Mac, iPad, iPhone). Own catalogue, own PIN, browser storage only" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f4f8fd;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="1660" height="660" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;sw.js&lt;/b&gt; service worker&lt;br&gt;network first; offline: cached app shell&lt;br&gt;never caches Google or video bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="520" width="240" height="70" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;index.html · styles.css · app.js&lt;/b&gt;&lt;br&gt;library, series, search, Settings, playlists, PIN prompts, Media Session, routes and data-state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="520" width="620" height="70" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;pin.js&lt;/b&gt;&lt;br&gt;PIN (4–6 digits), asked for every play and in Settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="200" height="70" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;features.js&lt;/b&gt;&lt;br&gt;optional features, switched in Settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="650" width="200" height="70" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;library.js&lt;/b&gt;&lt;br&gt;catalogue: list, add stored / streamed, download, remove, hide" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="650" width="230" height="70" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;player.js&lt;/b&gt;&lt;br&gt;open, play only after PIN, pause free, seek, playlist next" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="650" width="230" height="70" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;drive.js&lt;/b&gt;&lt;br&gt;sign-in, Picker, folder listing, Drive byte source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="650" width="230" height="70" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;features/watch-time.js&lt;/b&gt;&lt;br&gt;watch-time budget per session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="200" height="60" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;features/face-id.js&lt;/b&gt;&lt;br&gt;Face ID / Touch ID answers the PIN prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fa;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="770" width="200" height="60" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;streamed.js&lt;/b&gt;&lt;br&gt;streamed entries: Drive file id, title, poster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="780" width="230" height="60" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Shaka Player 5.3.5&lt;/b&gt; (app/vendor)&lt;br&gt;offline Storage + DASH player" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="780" width="230" height="60" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;local-scheme.js&lt;/b&gt;&lt;br&gt;local:// scheme plugin; reads .kidsvideo tar parts from a byte source (picked file or Drive)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="780" width="230" height="70" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;&amp;lt;video&amp;gt;&lt;/b&gt; playsinline, no controls / autoplay&lt;br&gt;MSE / ManagedMediaSource" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="890" width="230" height="55" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;localStorage&lt;/b&gt;&lt;br&gt;PIN, feature switches, watch-time session, Drive sign-in, Face ID passkey id" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="300" height="90" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;IndexedDB “kids-catalogue”&lt;/b&gt;&lt;br&gt;streamed videos: title + poster only" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="1000" width="300" height="90" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Shaka offline IndexedDB&lt;/b&gt;&lt;br&gt;segments of stored and downloaded videos (plays offline)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="1000" width="320" height="90" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Cache Storage “app-v2”&lt;/b&gt;&lt;br&gt;app shell" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="1000" width="240" height="90" as="geometry"/></mxCell><mxCell id="c41" value="app files" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#